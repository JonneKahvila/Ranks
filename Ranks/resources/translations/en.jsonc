{
  // Ranks - English.
  //
  // This file must stay KEY-COMPLETE. A missing key renders the literal marker {lang}.{key} to
  // the player rather than falling back to English, so a partial translation is worse than none.
  //
  // {0}, {1}, ... are positional arguments; keep them in every translation even if the word order
  // changes. Colour tokens ([gold], [lime], [default], ...) are SwiftlyS2's chat colours.

  "prefix": "[ [darkred]Ranks [default]] ",

  // ---- Errors -------------------------------------------------------------

  "error.players_only": "[red]This command can only be used by a player.",
  "error.not_loaded": "[red]Your rank data has not loaded yet. Try again in a moment.",

  // ---- XP feedback -----------------------------------------------------

  "XP.gained": "[lime]+{0}[default] XP [grey]({1})",
  "XP.lost": "[red]-{0}[default] XP [grey]({1})",

  // Deliberately carries no reasons: the per-event lines are what name them, and this replaces
  // those lines rather than summarising them.
  "XP.summary": "[default]Round summary: [gold]{0}{1}[default] XP",

  // ---- Rank changes -------------------------------------------------------

  "rank.promoted": "[green]Rank up![default] You are now [gold]{0}[default] with [lime]{1}[default] XP.",
  "rank.demoted": "[red]Rank down.[default] You are now [gold]{0}[default] with [lime]{1}[default] XP.",

  // ---- Self reset ---------------------------------------------------------

  "reset.confirm": "[red]This wipes your current XP and statistics.[default] Type the command again within [gold]{0}[default] seconds to confirm.",
  "reset.done": "[green]Your rank has been reset.",

  // ---- Playtime -----------------------------------------------------------
  //
  // Time connected to the server, counted as K4-LevelRanks counted it: warmup, spectating and an
  // empty server included. {0} in the first two is a duration built from the duration.* keys.

  "playtime.mine": "You have spent [gold]{0}[default] on this server.",
  // Replaces playtime.mine while seasons are on, when the figure is this season's.
  "playtime.mine_season": "You have spent [gold]{0}[default] on this server this season.",
  // {0} is the player's position, {1} how many players are ranked.
  "playtime.position": "You are ranked [gold]#{0}[default] out of [gold]{1} players[default] by playtime.",
  "playtime.position_season": "You are ranked [gold]#{0}[default] out of [gold]{1} players[default] by playtime this season.",

  // A duration, largest unit first; zero leading units are dropped. {0} days, {1} hours,
  // {2} minutes; then {0} hours, {1} minutes; then {0} minutes.
  "duration.days": "{0}d {1}h {2}m",
  "duration.hours": "{0}h {1}m",
  "duration.minutes": "{0}m",

  // ---- Seasons ------------------------------------------------------------
  //
  // Only when seasons are on: Database.VirtualPurgeMode 1 (monthly), or VirtualPurgeDays above
  // zero. A season is one period: everyone's rank starts over when it ends, and the season that
  // closed stays browsable under Leaderboard.

  "period.started": "[gold]A new season has started![default] Everyone's rank starts over. Last season's standings are kept under [gold]Leaderboard[default].",

  // ---- Admin --------------------------------------------------------------

  "admin.usage": "[red]Usage:[default] {0} <target> <amount>",
  // No amount: this one takes a target and nothing else.
  "admin.usage_target": "[red]Usage:[default] {0} <target>",
  "admin.bad_amount": "[red]'{0}' is not a number.",
  "admin.no_target": "[red]No player matched '{0}'.",
  "admin.ambiguous_target": "[red]More than one player matched '{0}'. Use more of the name, or their SteamID or status id.",
  "admin.not_loaded": "[red]{0}'s rank data has not loaded yet. Try again in a moment.",
  "admin.adjusted": "[lime]{0}[default] now has [gold]{1}[default] XP.",
  "admin.reset": "[lime]{0}[default] has been reset.",

  // ---- Help ---------------------------------------------------------------
  //
  // Chat, not menu rows: a menu row is one centred line that clips at roughly 42 characters.
  // Chat tags here, not HTML.
  //
  // {0} is the command's CONFIGURED name from commands.jsonc, without the ! prefix — so a
  // renamed command describes itself correctly and a removed one is not listed at all. Keep the
  // literal "!" in front of {0}.

  "help.header": "[gold]Available commands:",
  "help.rank": "[gold]!{0} [default]- Your detailed stats, settings and ranks info",
  "help.stats": "[gold]!{0} [default]- Your statistics menu",
  "help.mytime": "[gold]!{0} [default]- How long you have played on this server",
  "help.ranks": "[gold]!{0} [default]- All available ranks",
  "help.top": "[gold]!{0} [default]- Leaderboard of top players. Select a player to view their stats",
  "help.ttop": "[gold]!{0} [default]- Leaderboard by playtime, with your position in chat",
  "help.resetmyrank": "[gold]!{0} [default]- Wipes your own XP and statistics. Asks to confirm first",

  // Shown only to a player who holds the permission on at least one of these, and each line only
  // to someone who can run that command — so this never advertises something that would be
  // refused. {0} is the configured name, as above.

  "help.admin_header": "[gold]Admin commands:",
  "help.setpoints": "[gold]!{0} [grey]<target Name/SteamID/StatusID> <amount> [default]- Sets the target's XP to the exact amount",
  "help.givepoints": "[gold]!{0} [grey]<target Name/SteamID/StatusID> <amount> [default]- Adds XP to the target",
  "help.removepoints": "[gold]!{0} [grey]<target Name/SteamID/StatusID> <amount> [default]- Subtracts XP from the target",
  "help.resetrank": "[gold]!{0} [grey]<target Name/SteamID/StatusID> [default]- Wipes the target's XP and statistics",

  // ---- Menus --------------------------------------------------------------
  //
  // The whole player-facing surface lives here: !rank opens the root and every other command is
  // a shortcut to one of its branches. Preferences and help have no command at all.

  "menu.root.title": "Ranks",
  "menu.root.rank": "My rank",
  "menu.root.stats": "Statistics",
  "menu.root.top": "Leaderboard",
  "menu.root.settings": "Settings",
  "menu.root.help": "Help (shown in chat)",
  // Only rendered for a player who can run at least one admin command.
  "menu.root.admin": "Admin commands (shown in chat)",

  "menu.rank.title": "Your rank",
  "menu.rank.current": "Rank: {0}",
  "menu.rank.XP": "XP: {0}",
  "menu.rank.next": "{0} in {1} XP",
  "menu.rank.top_band": "Highest rank reached",
  "menu.rank.ladder": "Show all ranks",

  "menu.ladder.title": "Rank ladder",
  "menu.ladder.row": "{0} - {1} XP",
  "menu.ladder.row_current": "> {0} - {1} XP",

  "menu.stats.title": "Statistics",
  "menu.stats.main": "Main statistics",
  "menu.stats.main_title": "Main statistics",
  // The three rows below replace "Main statistics" while seasons are on.
  "menu.stats.current": "This season",
  "menu.stats.alltime": "All-time statistics",
  "menu.stats.previous": "Previous seasons",
  "menu.stats.kills": "Kills: {0}",
  "menu.stats.deaths": "Deaths: {0}",
  "menu.stats.kd": "K/D: {0}",
  "menu.stats.assists": "Assists: {0}",
  "menu.stats.headshots": "Headshots: {0} ({1}% of kills)",
  "menu.stats.accuracy": "Accuracy: {0}% ({1} hit, {2} missed)",
  "menu.stats.rounds": "Rounds: {0} won, {1} lost",
  "menu.stats.matches": "Matches: {0} won, {1} lost",
  "menu.stats.bombs": "Bombs: {0} planted, {1} defused",
  // {0} is a duration built from the duration.* keys.
  "menu.stats.playtime": "Playtime: {0}",
  "menu.stats.modules_empty": "No statistics modules are installed.",

  "menu.settings.title": "Settings",
  "menu.settings.XP_messages": "XP messages",
  "menu.settings.reset": "Reset my rank",
  "menu.settings.reset_title": "Reset my rank",
  "menu.settings.reset_warning": "This wipes your current XP and statistics. It cannot be undone.",
  "menu.settings.reset_confirm": "Yes, reset everything",

  "menu.top.title": "Leaderboard",
  "menu.top.row": "#{0} {1} - {2}",
  "menu.top.hint": "Select to view this player's statistics",
  "menu.top.empty": "Nobody is ranked yet.",
  "menu.top.error": "The leaderboard is unavailable right now.",
  // Rows of the Leaderboard screen. Players stands for the XP board while seasons are off; with
  // them on, the three season rows replace it.
  "menu.top.players": "Players",
  "menu.top.current": "This season",
  "menu.top.alltime": "All time",
  "menu.top.previous": "Previous seasons",
  "menu.top.playtime": "Playtime",

  // The playtime board, opened from the Playtime row or !ttop. {0} position, {1} name, {2} a
  // duration built from the duration.* keys.
  "menu.toptime.title": "Top playtime",
  "menu.toptime.row": "#{0} {1} - {2}",

  "menu.period.title": "Previous seasons",
  // {0} is the season's first day, as yyyy-MM-dd in UTC. Used for a season that was not
  // exactly one calendar month.
  "menu.period.row": "Season from {0}",
  // A season that ran exactly one UTC calendar month. {0} is month.N below, {1} the year.
  "menu.period.month": "{0} {1}",
  // Everything recorded before seasons were switched on.
  "menu.period.initial": "Before seasons",
  // {0} is the season's last full day, yyyy-MM-dd in UTC; the next season starts at 00:00 UTC the
  // day after. Keep it short: a line wider than the menu is cut off.
  "menu.period.last_day": "Last day: {0}",
  // Replaces menu.period.last_day while the current season is a calendar month. {0} is
  // menu.period.month. Keep it after a colon, so a language can leave the month name uninflected.
  "menu.period.current_month": "Season: {0}",
  "menu.period.empty": "No previous seasons yet.",

  // Month names for menu.period.month, looked up as "month." + 1-12.
  "month.1": "January",
  "month.2": "February",
  "month.3": "March",
  "month.4": "April",
  "month.5": "May",
  "month.6": "June",
  "month.7": "July",
  "month.8": "August",
  "month.9": "September",
  "month.10": "October",
  "month.11": "November",
  "month.12": "December",

  // {0} is the player's stored name.
  "menu.playerstats.title": "{0}",
  "menu.playerstats.empty": "This player has no statistics stored.",

  // ---- Command help -------------------------------------------------------
  //
  // Shown by sw_help. Not a config field: it is player-facing, so it is translatable.

  // Keyed on the command's key in commands.jsonc, not on the display wording — the lookup is
  // command.{key}.help, so renaming these to match "XP" would render a raw marker instead.
  "command.rank.help": "Open the Ranks menu.",
  "command.ranks.help": "Show the full rank ladder.",
  "command.top.help": "Show the XP leaderboard.",
  "command.stats.help": "Show your statistics.",
  "command.mytime.help": "Show how long you have played on this server.",
  "command.ttop.help": "Show the playtime leaderboard.",
  "command.resetmyrank.help": "Reset your own XP and statistics. Requires confirmation.",
  "command.setpoints.help": "Set a player's XP to an exact value.",
  "command.givepoints.help": "Add XP to a player.",
  "command.removepoints.help": "Subtract XP from a player.",
  "command.resetrank.help": "Reset a player's XP and statistics.",

  // ---- Event names --------------------------------------------------------
  //
  // The label shown in a XP message. Only core's own keys are translated; a module calling
  // AddXP with its own reason string has that string shown verbatim, since core cannot ship
  // a key for a reason it has never heard of.

  "event.kill": "Kill",
  "event.death": "Death",
  "event.assist": "Assist",
  "event.assist_flash": "Flash Assist",
  "event.headshot": "Headshot",
  "event.suicide": "Suicide",
  "event.team_kill": "Team Kill",
  "event.team_assist": "Team Assist",
  "event.noscope": "No Scope",
  "event.wallbang": "Wallbang",
  "event.through_smoke": "Through Smoke",
  "event.blind_kill": "Blind Kill",
  "event.long_distance": "Long Distance",
  "event.knife_kill": "Knife Kill",
  "event.taser_kill": "Zeus Kill",
  "event.grenade_kill": "Grenade Kill",
  "event.inferno_kill": "Molotov/Incendiary Kill",
  "event.impact_kill": "Impact Kill",
  "event.bomb_plant": "Bomb Plant",
  "event.bomb_defuse": "Bomb Defuse",
  "event.bomb_defuse_others": "Bomb Defused",
  "event.bomb_exploded": "Bomb Exploded",
  "event.bomb_pickup": "Bomb Pickup",
  "event.bomb_drop": "Bomb Drop",
  "event.hostage_rescue": "Hostage Rescue",
  "event.hostage_rescue_all": "All Hostages Rescued",
  "event.hostage_hurt": "Hostage Hurt",
  "event.hostage_kill": "Hostage Kill",
  "event.round_win": "Round Win",
  "event.round_lose": "Round Loss",
  "event.mvp": "MVP",
  "event.match_win": "Match Win",
  "event.match_lose": "Match Loss",

  "event.streak.double": "Double Kill",
  "event.streak.triple": "Triple Kill",
  "event.streak.domination": "Domination",
  "event.streak.rampage": "Rampage",
  "event.streak.mega": "Mega Kill",
  "event.streak.ownage": "Ownage",
  "event.streak.ultra": "Ultra Kill",
  "event.streak.killing_spree": "Killing Spree",
  "event.streak.monster": "Monster Kill",
  "event.streak.unstoppable": "Unstoppable",
  "event.streak.godlike": "GODLIKE"
}
