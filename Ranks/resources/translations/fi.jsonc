{
  // Ranks - Finnish (suomi).
  //
  // Must stay KEY-COMPLETE with en.jsonc: a missing key renders the literal marker {lang}.{key}
  // to the player rather than falling back to English. See en.jsonc for what each key is and
  // what its {0}, {1}, ... arguments hold.

  "prefix": "[ [darkred]Ranks [default]] ",

  // ---- Errors -------------------------------------------------------------

  "error.players_only": "[red]Vain pelaajat voivat käyttää tätä komentoa.",
  "error.not_loaded": "[red]Rankkitietojasi ei ole vielä ladattu. Yritä hetken päästä uudelleen.",

  // ---- XP feedback -----------------------------------------------------

  "XP.gained": "[lime]+{0}[default] XP [grey]({1})",
  "XP.lost": "[red]-{0}[default] XP [grey]({1})",

  "XP.summary": "[default]Erän yhteenveto: [gold]{0}{1}[default] XP",

  // ---- Rank changes -------------------------------------------------------

  "rank.promoted": "[green]Rankki nousi![default] Rankkisi on nyt [gold]{0}[default], XP: [lime]{1}[default].",
  "rank.demoted": "[red]Rankki laski.[default] Rankkisi on nyt [gold]{0}[default], XP: [lime]{1}[default].",

  // ---- Self reset ---------------------------------------------------------

  "reset.confirm": "[red]Tämä nollaa nykyiset XP:si ja tilastosi.[default] Vahvista kirjoittamalla komento uudelleen [gold]{0}[default] sekunnin kuluessa.",
  "reset.done": "[green]Rankkisi on nollattu.",

  // ---- Playtime -----------------------------------------------------------

  "playtime.mine": "Olet pelannut tällä palvelimella [gold]{0}[default].",
  "playtime.mine_season": "Olet pelannut tällä palvelimella tällä kaudella [gold]{0}[default].",
  "playtime.position": "Olet peliajassa sijalla [gold]#{0}[default] / [gold]{1} pelaajaa[default].",
  "playtime.position_season": "Olet tämän kauden peliajassa sijalla [gold]#{0}[default] / [gold]{1} pelaajaa[default].",

  "duration.days": "{0} pv {1} t {2} min",
  "duration.hours": "{0} t {1} min",
  "duration.minutes": "{0} min",

  // ---- Seasons ------------------------------------------------------------

  "period.started": "[gold]Uusi kausi on alkanut![default] Kaikkien rankit alkavat alusta. Edellisen kauden sijoitukset löytyvät kohdasta [gold]Toplista[default].",

  // ---- Admin --------------------------------------------------------------

  "admin.usage": "[red]Käyttö:[default] {0} <kohde> <määrä>",
  "admin.usage_target": "[red]Käyttö:[default] {0} <kohde>",
  "admin.bad_amount": "[red]'{0}' ei ole numero.",
  "admin.no_target": "[red]Yksikään pelaaja ei vastannut hakua '{0}'.",
  "admin.ambiguous_target": "[red]Useampi pelaaja vastasi hakua '{0}'. Kirjoita nimestä enemmän tai käytä SteamID:tä tai status-ID:tä.",
  "admin.not_loaded": "[red]Pelaajan {0} rankkitietoja ei ole vielä ladattu. Yritä hetken päästä uudelleen.",
  "admin.adjusted": "Pelaajalla [lime]{0}[default] on nyt [gold]{1}[default] XP.",
  "admin.reset": "Pelaaja [lime]{0}[default] on nollattu.",

  // ---- Help ---------------------------------------------------------------

  "help.header": "[gold]Käytettävissä olevat komennot:",
  "help.rank": "[gold]!{0} [default]- Tarkat tilastosi, asetukset ja rankkitiedot",
  "help.stats": "[gold]!{0} [default]- Tilastovalikkosi",
  "help.mytime": "[gold]!{0} [default]- Kuinka kauan olet pelannut tällä palvelimella",
  "help.ranks": "[gold]!{0} [default]- Kaikki saatavilla olevat rankit",
  "help.top": "[gold]!{0} [default]- Parhaiden pelaajien toplista. Valitse pelaaja nähdäksesi tämän tilastot",
