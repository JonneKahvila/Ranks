{
  // Ranks_WeaponStats - English.
  //
  // Must stay KEY-COMPLETE: a missing key renders the literal marker {lang}.{key} to the player
  // rather than falling back to English.

  "error.players_only": "[red]That command can only be used by a player.",
  "error.unavailable": "[red]Weapon statistics are unavailable right now.",

  // ---- Menus --------------------------------------------------------------
  //
  // The two titles double as the labels core shows under its Statistics menu, so renaming one
  // renames the row there too.

  "menu.error": "These statistics are unavailable right now.",

  "menu.weapons.title": "Weapon stats",
  "menu.weapons.empty": "You have no weapon statistics yet.",
  "menu.weapons.hint": "Select to see where this weapon's hits landed",
  // Rows are one centred line and clip at roughly 42 characters, so damage is left to the API.
  "menu.weapons.row": "{0} | {1} Kills, {2}% HS, {3}% Accuracy",

  "menu.hitgroups.title": "Overall Hit Stats",
  "menu.hitgroups.empty": "You have not landed any hits yet.",
  "menu.hitgroups.row": "{0}: {1} hits ({2}%), {3} dmg",

  // {0} is the weapon, already stripped of its weapon_ prefix and upper-cased.
  "menu.weaponhits.title": "{0} - Hit Stats",

  // ---- Seasons ------------------------------------------------------------
  //
  // Only while core runs seasons (VirtualPurgeMode 1, monthly, or VirtualPurgeDays above zero).
  // Both rows under Statistics then open on these three choices; with seasons off they open their
  // lists exactly as before. The wording matches core's own season screens.

  "menu.period.current": "This season",
  "menu.period.alltime": "All time",
  "menu.period.previous": "Previous seasons",

  "menu.period.title": "Previous seasons",
  // {0} is the season's first day, as yyyy-MM-dd in UTC. Used for a season that was not exactly one calendar month.
  "menu.period.row": "Season from {0}",
  // A season that ran exactly one UTC calendar month. {0} is month.N below, {1} the year.
  "menu.period.month": "{0} {1}",
  // Everything recorded before seasons were switched on. Nothing was kept per season then, so this
  // one always opens empty here; those figures are all under All time.
  "menu.period.initial": "Before seasons",
  "menu.period.empty": "No previous seasons yet.",

  // Month names for menu.period.month, looked up as "month." + 1-12.
  "month.1": "January",
  "month.2": "February",
  "month.3": "March",
  "month.4": "April",
  "month.5": "May",
  "month.6": "June",
  "month.7": "July",
  "month.8": "August",
  "month.9": "September",
  "month.10": "October",
  "month.11": "November",
  "month.12": "December",

  // {0} is one of the season labels above.
  "menu.weapons.title_period": "Weapon stats - {0}",
  "menu.weapons.empty_period": "No weapon statistics in this season.",
  "menu.hitgroups.title_period": "Hit Stats - {0}",
  "menu.hitgroups.empty_period": "No hits landed in this season.",
  // {0} is the weapon as in menu.weaponhits.title, {1} one of the season labels above.
  "menu.weaponhits.title_period": "{0} - {1}",

  "hitgroup.generic": "Generic",
  "hitgroup.head": "Head",
  "hitgroup.chest": "Chest",
  "hitgroup.stomach": "Stomach",
  "hitgroup.left_arm": "Left arm",
  "hitgroup.right_arm": "Right arm",
  "hitgroup.left_leg": "Left leg",
  "hitgroup.right_leg": "Right leg",
  "hitgroup.neck": "Neck",
  "hitgroup.gear": "Gear",
  "hitgroup.special": "Special",
  "hitgroup.unknown": "Hitbox {0}",

  // Looked up as command.<name>.help, where <name> is the Command in commands.jsonc — rename the
  // command there and this key has to follow it.
  "command.weaponstats.help": "Show your per-weapon kills, accuracy and headshot rate."
}
