{
  // Ranks_CustomCombos - English.
  //
  // Must stay KEY-COMPLETE: a missing key renders the literal marker {lang}.{key} to the player
  // rather than falling back to English.
  //
  // Keys named combo.<key> are YOURS to add — one per combo you configure. A combo with no key
  // here still works; its chat line falls back to the bare combo name.

  // Looked up as command.<name>.help, where <name> is the Command in commands.jsonc — rename the
  // command there and this key has to follow it.
  "command.combos.help": "Shows the combos you have landed.",

  // ---- Menu ---------------------------------------------------------------
  //
  // The title doubles as the label core shows under its Statistics menu, so renaming it renames
  // the row there too.

  "menu.combos.title": "Combos",
  "menu.combos.empty": "You have not landed any combos yet.",
  "menu.combos.row": "{0}: {1}",
  "menu.combos.error": "Combo statistics are unavailable right now.",

  // ---- Seasons ------------------------------------------------------------
  //
  // Only while Ranks runs seasons (its Database.VirtualPurgeMode is 1, monthly, or VirtualPurgeDays
  // is above zero). The combos screen then opens on this season, with an "All time" row and a "Previous seasons" row above
  // the list. Worded like Ranks' own season rows, and short: a menu row clips at ~42 characters.

  // {0} is one of the labels below, so a title reads "Combos - This season".
  "menu.combos.title_in": "Combos - {0}",
  "menu.combos.current": "This season",
  "menu.combos.alltime": "All time",
  "menu.combos.previous": "Previous seasons",
  // {0} is the season's first day, as yyyy-MM-dd in UTC. Used for a season that was not exactly one calendar month.
  "menu.combos.season": "Season from {0}",
  // A season that ran exactly one UTC calendar month. {0} is month.N below, {1} the year.
  "menu.combos.month": "{0} {1}",
  // Everything recorded before seasons were switched on.
  "menu.combos.initial": "Before seasons",
  "menu.combos.empty_current": "No combos landed this season yet.",
  "menu.combos.empty_season": "No combos landed in that season.",
  // Shown for "Before seasons": combos are kept per season only from when seasons were switched
  // on, so the ones landed earlier are in the All time total instead.
  "menu.combos.empty_initial": "Older combos are counted in All time.",
  "menu.combos.seasons_empty": "No previous seasons yet.",

  // Month names for menu.combos.month, looked up as "month." + 1-12.
  "month.1": "January",
  "month.2": "February",
  "month.3": "March",
  "month.4": "April",
  "month.5": "May",
  "month.6": "June",
  "month.7": "July",
  "month.8": "August",
  "month.9": "September",
  "month.10": "October",
  "month.11": "November",
  "month.12": "December",

  // Matching the combos in resources/examples/combos.jsonc.
  "combo.noscope_hs": "{lime}No-scope headshot",
  "combo.wallbang_hs": "{lime}Wallbang headshot",
  "combo.knife_hs": "{lime}Knife headshot",
  "combo.airborne_sniper": "{lime}Airborne sniper kill",
  "combo.blind_nade": "{lime}Blind grenade kill",
  "combo.nade_double": "{lime}Grenade double kill",
  "combo.long_noscope": "{lime}Long-range no-scope"
}
